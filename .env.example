POSTGRES_DB=dtsys
POSTGRES_USER=dtsys
POSTGRES_PASSWORD=change_me_strong_password

REDIS_PASSWORD=change_me_redis_password

# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_secret_key_at_least_32_chars

FIRST_ADMIN_PASSWORD=changeme
# Browser origin(s) allowed to call the API: comma-separated or a JSON array.
# Production refuses to start if this still points at localhost.
ALLOWED_ORIGINS=https://your-domain.com
BASE_URL=https://your-domain.com

# Prometheus scrape token for /metrics (endpoint disabled when empty)
METRICS_TOKEN=
